  // 初始化 Firebase
  useEffect(() => {
    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error("Auth Error:", error);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // 讀取資料與版本升級處理
  useEffect(() => {
    if (!user || !db) return;
    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'mysite', 'mainData');
    
    const unsubscribe = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const data = docSnap.data();
        
        // --- 資料向下相容性處理 (避免舊格式報錯) ---
        if (!data.profile.avatar) data.profile.avatar = "";
        if (typeof data.profile.blood === 'string') data.profile.blood = { type: data.profile.blood, icon: "" };
        if (!data.profile.zodiac.icon) data.profile.zodiac.icon = "";
        if (!data.profile.mbti.icon) data.profile.mbti.icon = "";
        if (!data.profile.obsession) data.profile.obsession = defaultData.profile.obsession;
        if (!data.profile.quirks) data.profile.quirks = defaultData.profile.quirks;
        if (!data.goalsNote) data.goalsNote = defaultData.goalsNote;
        
        data.favorites.forEach(f => {
          if (!f.reviews) f.reviews = [];
        });

        // 如果讀取到的資料是舊版的字串陣列，就升級為物件陣列；這裡直接依賴 defaultData 確保新結構
        if (data.diet && data.diet.prefs) {
          data.diet.prefs.forEach((pref, pIdx) => {
            pref.items = pref.items.map((item, idx) => {
              if (typeof item === 'string') {
                return { id: Date.now() + idx, name: item, image: "", reason: "" };
              }
              return item;
            });
          });
        }

        // 為了確保你最新提供的豐富資料能生效（若這是你第一次覆蓋），我們在本地優先使用 defaultData 裡面豐富的 prefs
        // 在正式發布上線時可以拿掉這行，但為了讓畫面直接呈現你的完整列表：
        data.diet.prefs = defaultData.diet.prefs;

        setSiteData(data);
      } else {
        setDoc(docRef, defaultData);
      }
    }, (error) => console.error("Fetch Data Error:", error));

    return () => unsubscribe();
  }, [user]);

  // 儲存資料
  const handleSave = async () => {
    if (!db || !user) {
      setIsEditing(false);
      return;
    }
    setSaving(true);
    try {
      const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'mysite', 'mainData');
      await setDoc(docRef, siteData);
      setIsEditing(false);
    } catch (error) {
      console.error("Save Error:", error);
    } finally {
      setSaving(false);
    }
  };

  const updateData = (section, key, value) => {
    setSiteData(prev => ({ ...prev, [section]: { ...prev[section], [key]: value } }));
  };

  const tabs = [
