                    ) : (
                      <div className="py-12 text-center text-[#A39A8A] italic">
                        還沒有建立任何紀錄喔...
                      </div>
                    )}

                    {/* 新增心得按鈕 */}
                    {isEditing && (
                      <button 
                        onClick={() => {
                          const newFavs = [...siteData.favorites];
                          const favIdx = newFavs.findIndex(f => f.id === selectedFavorite.id);
                          if (!newFavs[favIdx].reviews) newFavs[favIdx].reviews = [];
                          newFavs[favIdx].reviews.push({ id: Date.now(), title: "新紀錄標題", image: "", content: "", rating: 0 });
                          setSiteData({...siteData, favorites: newFavs});
                        }}
                        className="w-full py-3 border-2 border-dashed border-[#D5D0C5] rounded-xl text-[#9A9285] hover:bg-[#F4F1EA] hover:text-[#5A5043] transition-colors flex items-center justify-center font-medium"
                      >
                        <Plus size={16} className="mr-2"/> 新增紀錄
                      </button>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* --- Tab 3: 飲食 --- */}
          {activeTab === 'diet' && (
            <div>
              {/* 飲食專屬標題 (這不是挑食...) */}
              <div className="text-center mb-8 border-b border-[#EBE7DF] pb-6">
                <h2 className="text-xl font-bold text-[#5A5043] mb-2 tracking-wider">這不是挑食，是講究 !</h2>
                <p className="text-sm text-[#8C8477]">對食物有原則是基本的尊重 ❤️</p>
              </div>
              
              {/* 表格區塊 */}
              <div className="bg-white border border-[#EBE7DF] rounded-xl p-6 shadow-sm mb-8">
                <div className="space-y-4">
                  {siteData.diet.table.map((row, idx) => (
                    <div key={row.id} className={`flex items-start py-2 relative group ${idx !== siteData.diet.table.length - 1 ? 'border-b border-[#F4F1EA]' : ''}`}>
                      
                      {isEditing && (
                        <button 
                          onClick={() => {
                            const newTable = [...siteData.diet.table];
                            newTable.splice(idx, 1);
                            setSiteData({...siteData, diet: {...siteData.diet, table: newTable}});
                          }}
                          className="absolute -left-6 top-2 text-red-300 hover:text-red-500 transition-colors"
                        >
                          <Trash2 size={14} />
                        </button>
                      )}

                      <div className="w-16 text-xs text-[#9A9285] pt-0.5">
                         <EditableText value={row.category} isEditing={isEditing} placeholder="類別" onChange={v => {
                            const newTable = [...siteData.diet.table];
                            newTable[idx].category = v;
                            setSiteData({...siteData, diet: {...siteData.diet, table: newTable}});
                          }} />
                      </div>
                      <div className="flex-1 text-sm">
                        <EditableText value={row.items} isEditing={isEditing} placeholder="項目..." onChange={v => {
                          const newTable = [...siteData.diet.table];
                          newTable[idx].items = v;
                          setSiteData({...siteData, diet: {...siteData.diet, table: newTable}});
                        }} />
                      </div>
                    </div>
                  ))}
                  
                  {isEditing && (
                    <button 
                      onClick={() => {
                        const newTable = [...siteData.diet.table];
                        newTable.push({ id: Date.now(), category: "新類別", items: "" });
                        setSiteData({...siteData, diet: {...siteData.diet, table: newTable}});
                      }}
                      className="mt-2 text-xs text-[#9A9285] flex items-center hover:text-[#5A5043]"
                    >
                      <Plus size={14} className="mr-1"/> 新增表格列
                    </button>
                  )}
                </div>
              </div>

              {/* 篩選標籤 */}
              <div className="mb-6 flex flex-wrap gap-2">
                {['全部', ...siteData.diet.prefs.map(p => p.level)].map(filter => (
                  <button 
                    key={filter}
                    onClick={() => setDietFilter(filter)}
                    className={`px-4 py-1.5 rounded-lg text-sm transition-colors border ${
                      dietFilter === filter 
                        ? 'bg-white border-[#D5D0C5] text-[#5A5043] shadow-sm font-medium' 
                        : 'bg-transparent border-transparent text-[#9A9285] hover:bg-[#F4F1EA]'
                    }`}
                  >
                    {filter}
                  </button>
                ))}
              </div>

              {/* 喜好資料列表 */}
              <div className="space-y-8">
                {siteData.diet.prefs
                  .filter(pref => dietFilter === '全部' || dietFilter === pref.level)
                  .map((pref) => {
                    const rawIndex = siteData.diet.prefs.findIndex(p => p.level === pref.level);
                    const colorClass = dietColorClasses[rawIndex % dietColorClasses.length];

                    return (
                      <div key={pref.level}>
                        <div className="text-sm font-bold text-[#5A5043] mb-4 flex items-center border-l-4 border-amber-300 pl-3">
                          <EditableText value={pref.level} isEditing={isEditing} onChange={v => {
                            const newPrefs = [...siteData.diet.prefs];
                            newPrefs[rawIndex].level = v;
                            setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                          }} />
                        </div>
                        
                        {dietFilter === '全部' ? (
                          /* 全部模式：只顯示標籤總覽，保持清爽 */
                          <div className="flex flex-wrap gap-2 items-center">
                            {pref.items.map((item, idx) => (
                              <div key={item.id} className={`px-3 py-1.5 bg-white border rounded-full text-sm shadow-sm relative group transition-colors ${colorClass}`}>
                                {item.name}
                                {isEditing && (
                                  <button 
                                    onClick={() => {
                                      const newPrefs = [...siteData.diet.prefs];
                                      newPrefs[rawIndex].items.splice(idx, 1);
                                      setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                    }}
                                    className="absolute -top-1.5 -right-1.5 bg-red-500 text-white rounded-full p-0.5 shadow-md hover:bg-red-600 scale-0 group-hover:scale-100 transition-transform"
                                  >
                                    <X size={10} />
                                  </button>
                                )}
                              </div>
                            ))}
                            
                            {/* 編輯模式全部頁面提供簡單新增 */}
                            {isEditing && (
                              <button 
                                onClick={() => {
                                  const newPrefs = [...siteData.diet.prefs];
                                  newPrefs[rawIndex].items.push({ id: Date.now(), name: "新食物", image: "", reason: "" });
                                  setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                }}
                                className="bg-white border border-dashed border-[#D5D0C5] text-[#9A9285] hover:bg-[#F4F1EA] px-3 py-1.5 rounded-full text-sm transition-colors flex items-center"
                              >
                                <Plus size={14} className="mr-1" /> 新增
                              </button>
                            )}
                          </div>
                        ) : (
                          /* 獨立頁面模式：顯示帶有照片與原因的詳細卡片 */
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {pref.items.map((item, idx) => (
                              <div key={item.id} className="flex gap-4 p-4 bg-white border border-[#EBE7DF] shadow-sm rounded-xl relative group">
                                {isEditing && (
                                  <button 
                                    onClick={() => {
                                      const newPrefs = [...siteData.diet.prefs];
                                      newPrefs[rawIndex].items.splice(idx, 1);
                                      setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                    }}
                                    className="absolute top-2 right-2 p-1.5 text-red-400 hover:bg-red-50 hover:text-red-600 rounded-lg transition-colors z-10"
                                  >
                                    <Trash2 size={16} />
                                  </button>
                                )}

                                <div className="w-20 h-20 bg-[#F8F6F0] rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center border border-[#EBE7DF]">
                                  {item.image ? (
                                    <img src={item.image} alt={item.name} className="w-full h-full object-cover" />
                                  ) : (
                                    <ImageIcon className="text-[#D5D0C5]" size={24}/>
                                  )}
                                </div>
                                
                                <div className="flex-1 pr-6">
                                  {isEditing && (
                                    <div className="flex gap-2 mb-2">
                                      <input 
                                        type="text" placeholder="食物圖片網址..." value={item.image || ''}
                                        onChange={e => {
                                          const newPrefs = [...siteData.diet.prefs];
                                          newPrefs[rawIndex].items[idx].image = e.target.value;
                                          setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                        }}
                                        className="flex-1 text-[10px] p-1.5 bg-gray-50 border border-gray-200 rounded outline-none"
                                      />
                                      <ImageUploader 
                                        onUpload={val => {
                                          const newPrefs = [...siteData.diet.prefs];
                                          newPrefs[rawIndex].items[idx].image = val;
                                          setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                        }}
                                      />
                                    </div>
                                  )}

                                  <div className={`inline-block px-2 py-0.5 rounded text-xs font-bold mb-2 shadow-sm border ${colorClass}`}>
                                    <EditableText 
                                      value={item.name} isEditing={isEditing} placeholder="食物名稱..." 
                                      onChange={v => {
                                        const newPrefs = [...siteData.diet.prefs];
                                        newPrefs[rawIndex].items[idx].name = v;
                                        setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                      }}
                                    />
                                  </div>
                                  
                                  <div className="text-sm text-[#7A7265] leading-relaxed">
                                    <EditableText 
                                      value={item.reason} isEditing={isEditing} multiline placeholder="原因..." 
                                      onChange={v => {
                                        const newPrefs = [...siteData.diet.prefs];
                                        newPrefs[rawIndex].items[idx].reason = v;
                                        setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                      }}
                                    />
                                  </div>
                                </div>
                              </div>
                            ))}
                            
                            {isEditing && (
                              <button 
                                onClick={() => {
                                  const newPrefs = [...siteData.diet.prefs];
                                  newPrefs[rawIndex].items.push({ id: Date.now(), name: "新食物", image: "", reason: "填寫原因..." });
                                  setSiteData({...siteData, diet: {...siteData.diet, prefs: newPrefs}});
                                }}
                                className="border-2 border-dashed border-[#D5D0C5] rounded-xl text-[#9A9285] hover:bg-[#F4F1EA] hover:text-[#5A5043] transition-colors flex items-center justify-center font-medium min-h-[120px]"
                              >
                                <Plus size={16} className="mr-2"/> 新增項目
                              </button>
                            )}
                          </div>
                        )}
                      </div>
                    );
                })}
              </div>
            </div>
          )}

          {/* --- Tab 4: 清單 --- */}
          {activeTab === 'lists' && (
            <div>
              <div className="text-xs text-[#9A9285] ml-1 mb-4">待辦 / 願望清單</div>
              
              <div className="flex gap-2 mb-6">
                {['全部', '想看', '看完'].map(filter => (
                  <button 
                    key={filter}
                    onClick={() => setListFilter(filter)}
                    className={`px-4 py-1.5 rounded-lg text-sm transition-colors border ${
                      listFilter === filter 
                        ? 'bg-white border-[#D5D0C5] text-[#5A5043] shadow-sm font-medium' 
                        : 'bg-transparent border-transparent text-[#9A9285] hover:bg-[#F4F1EA]'
                    }`}
                  >
                    {filter}
                  </button>
                ))}
              </div>

              <div className="bg-white border border-[#EBE7DF] rounded-xl p-4 shadow-sm">
                <div className="space-y-1">
                  {siteData.lists
                    .filter(item => {
                      if (listFilter === '想看') return item.status === 'want';
                      if (listFilter === '看完') return item.status === 'done';
                      return true;
                    })
                    .map((item, idx) => (
                    <div key={item.id} className={`flex items-start p-3 relative group ${idx !== siteData.lists.length - 1 ? 'border-b border-[#F4F1EA]' : ''}`}>
                      
                      {isEditing && (
                        <button 
                          onClick={() => {
                            const newLists = [...siteData.lists];
                            newLists.splice(idx, 1);
                            setSiteData({...siteData, lists: newLists});
                          }}
                          className="absolute right-2 top-4 text-red-300 hover:text-red-500 transition-colors"
                        >
                          <Trash2 size={16} />
                        </button>
                      )}

                      <button 
                        onClick={() => {
                          if (isEditing) {
                            const newLists = [...siteData.lists];
                            newLists[idx].status = item.status === 'done' ? 'want' : 'done';
                            setSiteData({...siteData, lists: newLists});
                          }
                        }}
                        className={`mt-0.5 flex-shrink-0 w-5 h-5 rounded flex items-center justify-center border mr-4 transition-colors ${
                          item.status === 'done' 
                            ? 'bg-[#EFECE5] border-[#D5D0C5] text-[#9A9285]' 
                            : 'border-[#D5D0C5] text-transparent hover:border-[#BFA888]'
                        } ${isEditing ? 'cursor-pointer' : 'cursor-default'}`}
                      >
                        {item.status === 'done' && <Check size={14} />}
                      </button>
                      
                      <div className={`flex-1 pr-6 ${item.status === 'done' ? 'opacity-60 line-through' : ''}`}>
                        <div className="text-sm font-medium mb-1">
                          <EditableText value={item.title} isEditing={isEditing} onChange={v => {
                            const newLists = [...siteData.lists];
                            newLists[idx].title = v;
                            setSiteData({...siteData, lists: newLists});
                          }} />
                        </div>
                        <div className="text-xs text-[#9A9285]">
                          <EditableText value={item.subtitle} isEditing={isEditing} onChange={v => {
                            const newLists = [...siteData.lists];
                            newLists[idx].subtitle = v;
                            setSiteData({...siteData, lists: newLists});
                          }} />
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                
                {isEditing && (
                  <button 
                    onClick={() => {
                      const newLists = [...siteData.lists];
                      newLists.push({ id: Date.now(), title: "新項目", subtitle: "描述", status: "want" });
                      setSiteData({...siteData, lists: newLists});
                    }}
                    className="w-full mt-4 py-3 border-2 border-dashed border-[#D5D0C5] rounded-xl text-[#9A9285] hover:bg-[#F4F1EA] hover:text-[#5A5043] transition-colors flex items-center justify-center font-medium"
                  >
                    <Plus size={16} className="mr-2"/> 新增待辦 / 願望
                  </button>
                )}
              </div>
            </div>
          )}

          {/* --- Tab 5: 目標 --- */}
          {activeTab === 'goals' && (
            <div>
              <div className="text-xs text-[#9A9285] ml-1 mb-4">年度目標與進度</div>
              
              <div className="border border-dashed border-[#D5D0C5] bg-white/50 rounded-lg p-3 text-center text-xs text-[#9A9285] mb-6">
                <EditableText 
                  value={siteData.goalsNote} isEditing={isEditing} placeholder="備註文字..." 
                  onChange={v => setSiteData({...siteData, goalsNote: v})} 
                />
              </div>

              <div className="bg-white border border-[#EBE7DF] rounded-xl p-6 shadow-sm">
                <div className="space-y-6">
                  {siteData.goals.map((goal, idx) => (
                    <div key={goal.id} className={`flex items-start relative ${idx !== siteData.goals.length - 1 ? 'border-b border-[#F4F1EA] pb-6' : ''}`}>
                      
                      {isEditing && (
                        <button 
                          onClick={() => {
                            const newGoals = [...siteData.goals];
                            newGoals.splice(idx, 1);
                            setSiteData({...siteData, goals: newGoals});
                          }}
                          className="absolute -top-2 right-0 p-2 text-red-300 hover:text-red-500 transition-colors"
                        >
                          <Trash2 size={16} />
                        </button>
                      )}

                      <div className="text-[#C1BCB1] font-mono text-sm mr-4 pt-0.5 w-6">
                        {String(idx + 1).padStart(2, '0')}
                      </div>
                      
                      <div className="flex-1 pr-6">
                        <div className="text-sm font-medium mb-1.5 text-[#5A5043]">
                          <EditableText value={goal.title} isEditing={isEditing} placeholder="目標標題" onChange={v => {
                            const newGoals = [...siteData.goals];
                            newGoals[idx].title = v;
                            setSiteData({...siteData, goals: newGoals});
                          }} />
                        </div>
                        <div className="text-xs text-[#8C8477] mb-3">
                          <EditableText value={goal.desc} isEditing={isEditing} placeholder="目標描述..." onChange={v => {
                            const newGoals = [...siteData.goals];
                            newGoals[idx].desc = v;
                            setSiteData({...siteData, goals: newGoals});
                          }} />
                        </div>
                        
                        {/* 目標進度條 */}
                        <div className="flex items-center gap-3">
                          <div className="flex-1 bg-[#EFECE5] rounded-full h-1.5 overflow-hidden">
                            <div 
                              className="bg-amber-400 h-1.5 rounded-full transition-all duration-500 ease-out" 
                              style={{ width: `${goal.progress || 0}%` }}
                            ></div>
                          </div>
                          <span className="text-[10px] text-[#A39A8A] font-mono w-6 text-right">
                            {goal.progress || 0}%
                          </span>
                        </div>
                        
                        {/* 編輯模式下的進度條滑桿 */}
                        {isEditing && (
                          <input 
                            type="range" min="0" max="100" step="5" value={goal.progress || 0}
                            onChange={e => {
                              const newGoals = [...siteData.goals];
                              newGoals[idx].progress = Number(e.target.value);
                              setSiteData({...siteData, goals: newGoals});
                            }}
                            className="w-full mt-3 accent-amber-500 h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                          />
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                {/* 新增目標按鈕 */}
                {isEditing && (
                  <button 
                    onClick={() => {
                      const newGoals = [...siteData.goals];
                      newGoals.push({ id: Date.now(), title: "新目標", desc: "", progress: 0 });
                      setSiteData({...siteData, goals: newGoals});
                    }}
                    className="w-full mt-6 py-3 border-2 border-dashed border-[#D5D0C5] rounded-xl text-[#9A9285] hover:bg-[#F4F1EA] hover:text-[#5A5043] transition-colors flex items-center justify-center font-medium"
                  >
                    <Plus size={16} className="mr-2"/> 新增目標
                  </button>
                )}
              </div>
            </div>
          )}

        </div>
      </div>

      {/* ================= 浮動編輯按鈕 ================= */}
      <div className="fixed bottom-6 right-6 flex flex-col gap-2 z-50">
        {isEditing && (
          <button 
            onClick={handleSave}
            disabled={saving}
            className="w-12 h-12 bg-amber-600 text-white rounded-full shadow-[0_4px_12px_rgba(217,119,6,0.3)] flex items-center justify-center hover:bg-amber-700 transition-transform active:scale-95 disabled:opacity-50"
            title="儲存變更"
          >
            <Save size={20} />
          </button>
        )}
        <button 
          onClick={() => setIsEditing(!isEditing)}
          className={`w-12 h-12 rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.08)] flex items-center justify-center transition-transform active:scale-95 ${
            isEditing ? 'bg-gray-700 text-white hover:bg-gray-800' : 'bg-white text-[#7A7265] border border-[#EBE7DF] hover:bg-[#F4F1EA]'
          }`}
          title={isEditing ? "退出編輯模式" : "進入編輯模式"}
        >
          <Edit3 size={20} />
        </button>
      </div>

    </div>
  );
}
